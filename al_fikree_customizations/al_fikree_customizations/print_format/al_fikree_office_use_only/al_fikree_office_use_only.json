 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 20px;\n        }\n        .header {\n            width: 100%;\n            text-align: center;\n            background-color: #ECFFF2;\n            padding: 10px;\n            font-size: 18px;\n            font-weight: bold;\n        }\n        .details {\n            width: 40%;\n            display: flex;\n            justify-content: space-between;\n        }\n        .details-column {\n            width: 48%;\n        }\n        .underline {\n            display: block;\n            border-bottom: 1px dashed #000;\n            padding-bottom: 3px;\n            margin-bottom: 10px;\n        }\n        .footer {\n            width: 100%;\n            margin-top: 20px;\n            border-top: 1px solid black;\n            padding-top: 10px;\n        }\n        .footer-columns {\n            display: flex;\n            justify-content: space-between;\n        }\n        .footer-column {\n            width: 48%;\n            border-bottom: 1px solid black;\n            text-align: center;\n            padding-bottom: 5px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">For Office Use Only</div>\n\n    <div class=\"details\">\n        <div class=\"details-column\">\n            <p>Total Days</p>\n            <p>Present:</p>\n            <p>Absent:</p>\n            <p>Sick:</p>\n            <p>Medical:</p>\n            <p>Friday:</p>\n            <p>Holiday:</p>\n            <p>Leave:</p>\n            <p>OT:</p>\n            <p>Extra Hours:</p>\n        </div>\n        <div class=\"details-column\">\n            <p class=\"underline\">{{ doc.payment_days }}</p>\n            <p class=\"underline\">{{ doc.absent_days }}</p>\n            <p class=\"underline\">0</p>\n            <p class=\"underline\">0</p>\n            <p class=\"underline\">0</p>\n            <p class=\"underline\">0</p>\n            <p class=\"underline\">{{ doc.absent_days }}</p>\n            <p class=\"underline\">{{ total_ot }}</p>\n            <p class=\"underline\">{{ total_extra_hours }}</p>\n        </div>\n    </div>\n\n    <div class=\"footer\">\n        <div class=\"footer-columns\">\n            <div class=\"footer-column\">---</div>\n            <div class=\"footer-column\">---</div>\n        </div>\n    </div>\n</body>\n</html>\n",
